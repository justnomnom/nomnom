    "lodash-es": "^4.18.1",
    "mermaid": "^11.14.0",
    "react-router": "^6.30.2",
    "react-router-dom": "^6.30.2",
    "rimraf": "^5.0.8",
    "glob": "^13.0.6",
    "esbuild": "^0.25.0",
    "vite": "^6.4.2",
    "sharp": "^0.34.3",
    "eslint-config-airbnb": {
      "eslint": "$eslint",
