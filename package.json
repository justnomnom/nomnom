    "@capacitor/status-bar": "^8.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.3.2",
    "@iconify-json/eva": "^1.2.3",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "^4.1.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.2",
    "@next/mdx": "^16.2.10",
    "@next/third-parties": "^16.2.10",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@tinacms/cli": "^2.5.5",
    "@types/mdx": "^2.0.14",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.28",
    "antd": "^5.27.0",
    "autoprefixer": "^10.5.3",
    "autosuggest-highlight": "^3.3.4",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash": "^4.18.1",
    "mapbox-gl": "^3.26.0",
    "mui-one-time-password-input": "^5.0.0",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "nprogress": "^0.2.0",
    "postcss": "^8.5.19",
    "posthog-js": "^1.400.1",
    "posthog-node": "^5.47.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.9",
    "react-lazy-load-image-component": "^1.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-map-gl": "^8.1.1",
    "resend": "^4.2.0",
    "sharp": "^0.34.3",
    "simplebar-react": "^3.2.4",
    "stripe": "^22.3.1",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1",
    "swr": "^2.4.2",
    "tailwindcss": "^4.3.2",
    "tinacms": "^3.10.1",
    "web-push": "^3.6.7",
    "yet-another-react-lightbox": "^3.32.1",
    "yup": "^1.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "dotenv": "^17.4.2",
