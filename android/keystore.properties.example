# Copy to android/keystore.properties (gitignored) and fill in values.
# Generate a upload keystore once (keep backups — Play App Signing still needs your upload key):
#
#   keytool -genkey -v -keystore nomnom-upload.keystore -alias nomnom \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.

storeFile=nomnom-upload.keystore
storePassword=REPLACE_ME
keyAlias=nomnom
keyPassword=REPLACE_ME
