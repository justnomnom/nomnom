# =============================================================================
# Setup
# =============================================================================
# Copy values into `.env.local` (preferred for secrets; gitignored) and/or `.env`.
# Next.js merges env files; later files override earlier ones per Next docs.
# Playwright loads `.env.local` then `.env` (see tests/e2e/load-env.ts) so E2E sees
# the same vars as `npm run dev`.

# =============================================================================
# Site & branding (public)
# =============================================================================
# Canonical public URL — metadata, absolute links, client-side `NEXT_PUBLIC_*`. Dev: http://localhost:3032
NEXT_PUBLIC_SITE_URL=http://localhost:3032

# Server-only canonical base for sitemap, JSON-LD, and server-only URL helpers (`src/content-platform/site-url.ts`,
# `src/libs/site-url.js`). Optional: falls back to `VERCEL_URL` on Vercel when unset.
SITE_URL=

# Public contact email (footer, support fallback)
NEXT_PUBLIC_CONTACT_EMAIL=info@justnomnom.com

# Bare domain (no scheme) shown in user-facing copy, e.g. legal pages (`src/config-global.js`). Default: justnomnom.com
# NEXT_PUBLIC_APP_DOMAIN=justnomnom.com

# Instagram profile URL — footer social link (hidden when unset)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourhandle

# App Store product page — when set, hero + rating badge link out for verifiable reviews (until then, copy shows “coming soon”)
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/nomnom/id000000000

# =============================================================================
# TinaCMS (Git-backed MDX — optional; content hub uses filesystem fallback)
# =============================================================================
# From https://app.tina.io — enables GraphQL-backed content (`src/content-platform/tina-queries.ts`)
NEXT_PUBLIC_TINA_CLIENT_ID=
# Read-only token (server); never expose as NEXT_PUBLIC_*
TINA_TOKEN=
# Tina GraphQL endpoint: public URL is preferred for any client bundle that imports the generated client.
# If only `NEXT_PUBLIC_TINA_GRAPHQL_URL` is unset, `TINA_GRAPHQL_URL` is used (server-oriented override).
# Default in generated client when both unset: http://127.0.0.1:4001/graphql
# NEXT_PUBLIC_TINA_GRAPHQL_URL=http://127.0.0.1:4001/graphql
# TINA_GRAPHQL_URL=
# Content Git branch — Tina config uses first match: GITHUB_BRANCH → VERCEL_GIT_COMMIT_REF → HEAD → "main"
# (set automatically on Vercel/GitHub Actions; override locally if needed)
# Regenerate admin + client after schema changes: `npm run tina:build`

# =============================================================================
# Supabase (https://supabase.com/docs/guides/api/api-keys)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (anon) key — safe to expose in the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key — never use NEXT_PUBLIC_* (service role / server operations)
SUPABASE_SECRET_KEY=
# Standalone backfill scripts in `scripts/` also accept the legacy aliases SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY as fallbacks for the two values above.

# =============================================================================
# Stripe — paid lists (Connect Express). Webhook path: POST /api/webhooks/stripe
# =============================================================================
# Test keys: https://dashboard.stripe.com/test/apikeys — after STRIPE_SECRET_KEY is set: npm run stripe:setup-webhook
STRIPE_SECRET_KEY=
# Local webhooks: paste whsec_... from the `npm run stripe:listen` terminal (new secret each time you restart listen).
STRIPE_WEBHOOK_SECRET=
# Platform fee as a percent (e.g. 10 = 10%). Used with list pricing (`src/libs/stripe/list-stripe-constants.js`).
STRIPE_PLATFORM_FEE_PERCENT=10
# Client-visible min/max for monthly list prices in cents (validation / UI bounds). Code defaults: 399 / 50000.
NEXT_PUBLIC_LIST_PRICE_MIN_CENTS=399
NEXT_PUBLIC_LIST_PRICE_MAX_CENTS=50000
# Default Connect account country code when creating Express accounts
STRIPE_CONNECT_DEFAULT_COUNTRY=PT
# Override the webhook URL registered by `npm run stripe:setup-webhook` (defaults to SITE_URL/NEXT_PUBLIC_SITE_URL).
# STRIPE_WEBHOOK_URL=

# Free places shown before the paywall on a paid list. Server var; mirror to NEXT_PUBLIC_* for the browser. Default: 5.
# FREEMIUM_PREVIEW_COUNT=5
# NEXT_PUBLIC_FREEMIUM_PREVIEW_COUNT=5
# Stripe Tax code for one-time snapshot checkouts (`automatic_tax`). Default: txcd_10000000.
# STRIPE_LIST_SNAPSHOT_TAX_CODE=txcd_10000000
# Minimum one-time snapshot amount in cents. NEXT_PUBLIC_* preferred; server var is the fallback. Default: 50.
# NEXT_PUBLIC_LIST_SNAPSHOT_MIN_UNIT_CENTS=50
# LIST_SNAPSHOT_MIN_UNIT_CENTS=50
# Snapshot price = monthly subscription × ratio (0–1 exclusive). NEXT_PUBLIC_* preferred. Default: 0.45.
# NEXT_PUBLIC_LIST_SNAPSHOT_PRICE_RATIO=0.45
# LIST_SNAPSHOT_PRICE_RATIO=0.45

# =============================================================================
# Auth & database
# =============================================================================
# Comma-separated Supabase Auth user UUIDs allowed to open /dashboard/admin/* (see `src/libs/auth/admin-allowlist.js`).
# ADMIN_USER_IDS=

# Optional: canonical origin for Google OAuth / email links when it must match Supabase "Redirect URLs"
# exactly (tunnel, or http://localhost:3032 while the app is opened via 127.0.0.1). App dev server uses port 3032.
# NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=http://localhost:3032
#
# Local Google sign-in: Supabase Dashboard → Authentication → URL Configuration → add Redirect URL
#   http://localhost:3032/auth/callback
# Google Cloud Console → OAuth client → Authorized JavaScript origins: http://localhost:3032
#   (redirect URI stays https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback — not localhost)

# Direct Postgres password (server/tooling only — not bundled to the browser)
POSTGRES_PASSWORD=

# Bearer secret for Vercel Cron (`POST /api/cron/notification-digest`). Vercel sends `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=

# =============================================================================
# Maps — Mapbox GL JS (dashboard map). https://account.mapbox.com/access-tokens/
# =============================================================================
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# =============================================================================
# AI / ingest backends
# =============================================================================
# Alibaba Qwen via DashScope (OpenAI-compatible). Used to extract community-consensus
# from restaurant reviews during ingest (`src/libs/restaurant-ingest/review-consensus-ai.js`).
# ~3x cheaper than gpt-4o-mini for this input-heavy summarization workload.
# Get a key at https://dashscope.console.aliyun.com (international console accepts non-Chinese cards).
# Leave QWEN_API_KEY blank to disable consensus extraction (ingest still succeeds).
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
# Re-ingest only re-runs review-consensus AI when at least this many new reviews appear
# in the sampled set (or Google review_count delta when prior sample is missing). Default: 10.
# RESTAURANT_INGEST_MIN_NEW_REVIEWS_FOR_AI=10
# Default endpoint is the international host (https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
# Override only if you need the mainland-China endpoint:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Must-try dish labels — machine translation cache + LLM (`src/lib/ugc-translate.js`).
# Set to the literal string `false` to skip model calls and show stored labels only. Omit or any other value: enabled.
# UGC_TRANSLATE_ENABLED=false

# =============================================================================
# Restaurant search — natural language to tags (Discover sparkles; server-only)
# Provider: openai | anthropic | google | qwen (`src/lib/restaurant-search-llm.js`)
# =============================================================================
# Defaults to `openai` when unset. For the cheapest setup, use `qwen` and reuse the QWEN_API_KEY set above.
RESTAURANT_SEARCH_AI_PROVIDER=openai
# OpenAI — required if RESTAURANT_SEARCH_AI_PROVIDER=openai. The key is also read by Supabase
# Studio's AI assistant (supabase/config.toml). Model defaults to gpt-4o-mini if left blank.
OPENAI_API_KEY=
RESTAURANT_SEARCH_OPENAI_MODEL=
# Anthropic — required if RESTAURANT_SEARCH_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
RESTAURANT_SEARCH_ANTHROPIC_MODEL=
# Google Generative AI — required if RESTAURANT_SEARCH_AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
RESTAURANT_SEARCH_GOOGLE_MODEL=
# Qwen (OpenAI-compatible: DashScope, OpenRouter, etc.) — uses RESTAURANT_SEARCH_AI_PROVIDER=qwen.
# Runs through the same json-mode helper as ingest, reusing QWEN_API_KEY / QWEN_BASE_URL.
# Model falls back: RESTAURANT_SEARCH_QWEN_MODEL -> QWEN_MODEL -> qwen-turbo.
RESTAURANT_SEARCH_QWEN_MODEL=

# =============================================================================
# Email — Resend (`src/config-global.js` → RESEND_API; contact/FAQ + /api/email/send)
# Create an API key at https://resend.com/api-keys. Domain must be verified in Resend.
# =============================================================================
# Server-only API key for the Resend SDK. Without it, outbound email is disabled.
# Example: re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=
# "From" address for all app emails. Must use a domain verified in Resend.
# Example: JustNomNom <info@justnomnom.com>  or  info@justnomnom.com
RESEND_FROM_EMAIL=
# Inbox for public contact / FAQ / feedback forms (no arbitrary recipients).
# Also used as FEEDBACK_INBOUND_EMAIL when set. Example: info@justnomnom.com
RESEND_TO_EMAIL=
# Server-only Bearer for POST /api/email/send (cron, scripts). Public contact/FAQ use server actions.
EMAIL_OUTBOUND_SECRET=

# Server-only Bearer for POST /api/restaurants/ingest (automation / internal pipelines).
RESTAURANT_INGEST_SECRET=
# Used by `scripts/import-restaurants-from-json.mjs`: target ingest endpoint and parallel request count.
# INGEST_ENDPOINT=http://localhost:3032/api/restaurants/ingest
# CONCURRENCY=4
# MAX_RETRIES=4

# =============================================================================
# Rate limiting (optional — shared limits across serverless instances)
# =============================================================================
# Create a Redis database at https://upstash.com and paste REST credentials (`src/libs/email/rate-limit.js`).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Web Push (PWA notifications — VAPID; `src/config-global.js`, `src/api/push.js`)
# =============================================================================
# Generate a keypair: npx web-push generate-vapid-keys
# When set, push auto-enables via INTEGRATION_FLAGS.push. Without keys, in-app bell still works.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@justnomnom.com

# =============================================================================
# Observability — Sentry (enable `sentry: true` in INTEGRATION_FLAGS + next.config.js plugin)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=nomnom-ek
# SENTRY_PROJECT=nomnom
# NEXT_PUBLIC_SENTRY_DEBUG=false
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

# =============================================================================
# Analytics — PostHog (enable `posthog: true` in INTEGRATION_FLAGS in src/config-global.js)
# =============================================================================
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# In dev, events are off unless NEXT_PUBLIC_POSTHOG_DEV_MODE=true
# NEXT_PUBLIC_POSTHOG_DEV_MODE=false

# =============================================================================
# Embeds & widgets
# =============================================================================
# Sleekplan (enable `sleekplan: true` in INTEGRATION_FLAGS)
# NEXT_PUBLIC_SLEEKPLAN_PRODUCT_ID=

# Google Tag Manager container ID
# NEXT_PUBLIC_GTM_ID=

# =============================================================================
# Capacitor (native iOS / Android — `npx cap sync` reads these)
# =============================================================================
# Production: HTTPS origin the WebView loads (cleartext is off on Android automatically).
# CAPACITOR_SERVER_URL=https://your-domain.com
# LAN dev: use http:// + your machine IP (not localhost). Android cleartext is set automatically for http:// only.
# CAPACITOR_SERVER_URL=http://192.168.1.10:3032
# Optional: device log verbosity for native projects — use `none` for store release builds.
# CAPACITOR_LOGGING=none
# Or run: npm run cap:sync:release  (sets CAPACITOR_LOGGING=none and runs `cap sync`)
#
# One-time: npm run cap:android:setup  (creates upload keystore + android/keystore.properties)
# Each release: npm run cap:android:release  (bumps patch version by default, builds .aab)
# Uses CAPACITOR_SERVER_URL, or NEXT_PUBLIC_SITE_URL if unset.
#
# Optional overrides for `npm run cap:android:setup` (otherwise auto-generated):
# ANDROID_UPLOAD_KEYSTORE_PASSWORD=
# ANDROID_UPLOAD_KEY_PASSWORD=
# ANDROID_KEYSTORE_DN=

# =============================================================================
# Playwright E2E (`npm run test:e2e` — optional; public smoke tests skip auth if unset).
# Resolver unit tests (no Supabase): `npm run test:e2e:support-unit`. Full gate: `npm run test:e2e:all`.
# =============================================================================
# Same Supabase project as the app. Enable Email provider + create a dedicated test user (password).
# Dashboard layout requires onboarding: set users.onboarding_completed_at for that user in Postgres.
# Managed block (written by `node scripts/ensure-e2e-test-user.mjs`):
# <<< E2E_PLAYWRIGHT_BLOCK_START >>>
# E2E_BASE_URL=http://localhost:3032
# E2E_SUPABASE_URL=
# E2E_SUPABASE_ANON_KEY=   # alias for tests; same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# E2E_SUPABASE_SERVICE_ROLE_KEY=   # optional; falls back to SUPABASE_SECRET_KEY in test helpers
# E2E_TEST_USER_EMAIL=
# E2E_TEST_USER_USERNAME=   # optional: use public.users @handle instead of email
# E2E_TEST_USER_PASSWORD=
# <<< E2E_PLAYWRIGHT_BLOCK_END >>>
# Optional: if public.users email lookup fails (e.g. OAuth-only row), set the auth user UUID explicitly.
# E2E_TEST_USER_ID=
# Optional: do not auto-start Next (you already ran `npm run dev`).
# E2E_SKIP_WEBSERVER=1
# Optional: dev server command for Playwright (default `npm run dev:webpack` for stable startup).
# E2E_WEBSERVER_COMMAND=npm run dev:webpack
# Optional: existing public username for /u/:handle and /dashboard/u/:handle deep-link tests
# E2E_PUBLIC_PROFILE_USERNAME=
# Optional: Playwright parallel workers (default 1 — see playwright.config.cjs)
# PW_WORKERS=1
#
# Stripe money-path fixtures (written by `npm run stripe:e2e:setup`):
# <<< E2E_STRIPE_MONEY_PATH_BLOCK_START >>>
# E2E_STRIPE_CONNECT_ACCOUNT_ID=
# E2E_STRIPE_PRICE_ID=
# E2E_STRIPE_PRICE_AMOUNT_CENTS=500
# E2E_STRIPE_PRICE_CURRENCY=eur
# <<< E2E_STRIPE_MONEY_PATH_BLOCK_END >>>

# =============================================================================
# Platform & framework (normally automatic — do not set unless you know why)
# =============================================================================
# Vercel: VERCEL=1, VERCEL_URL (preview/prod hostname for URL fallbacks)
# Git/CI: CI, GITHUB_BRANCH, HEAD, VERCEL_GIT_COMMIT_REF (Tina branch, Playwright parallelism)
# Next.js: NODE_ENV, NEXT_PHASE, NEXT_RUNTIME
# Bundle analyzer: ANALYZE=true npm run build
# ANALYZE=
