<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: permit HTTP cleartext for LAN dev (CAPACITOR_SERVER_URL=http://192.168.x.x:3032).
  Release builds use src/main/res/xml/network_security_config.xml (cleartext off).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
