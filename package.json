{
  "name": "nomnom",
  "author": "nomnom",
  "version": "5.7.0",
  "description": "NomNom — discover restaurants through creators and real people",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3032",
    "dev:webpack": "next dev -p 3032 --webpack",
    "dev:trace": "cross-env NEXT_TURBOPACK_TRACING=1 next dev -p 3032 --turbopack",
    "start": "next start -p 3032",
    "content:sitemap-urls": "node scripts/generate-content-sitemap-urls.mjs",
    "prebuild": "node scripts/generate-content-sitemap-urls.mjs && node scripts/build-iconify-bundle.mjs",
    "build": "next build --webpack",
    "build:webpack": "next build --webpack",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:all": "npm run lint:fix && npm run prettier",
    "fix:all": "eslint --fix --max-warnings=0 \"src/**/*.{js,jsx}\" && prettier --write \"src/**/*.{js,jsx,ts,tsx}\" && eslint \"src/**/*.{js,jsx}\"",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "npm run rm:all && npm install && npm run dev",
    "re:build": "npm run rm:all && npm install && npm run build",
    "re:build-npm": "npm run rm:all && npm install && npm run build",
    "generate-types": "npx supabase gen types typescript --project-id jxknitagufcuyeozlazc --schema public > src/libs/supabase/types.ts",
    "generate-types:js": "npx supabase gen types typescript --project-id jxknitagufcuyeozlazc --schema public > src/libs/supabase/types.js",
    "supabase:types": "npm run generate-types && npm run generate-types:js",
    "supabase:link": "env-cmd -f ./.env.local supabase link --project-ref jxknitagufcuyeozlazc",
    "env:production:pull": "node scripts/vercel-env-sync.mjs pull",
    "env:production:push": "node scripts/vercel-env-sync.mjs push",
    "migration:new": "supabase migration new updated-schema",
    "supabase:db:push": "supabase db push",
    "supabase:db:push:all": "supabase db push --include-all",
    "supabase:db:pull": "supabase db pull",
    "migration:up": "supabase migration up --linked --debug && npm run supabase:types",
    "migration:squash": "supabase migration squash --linked",
    "tina:build": "tinacms build --noTelemetry --skip-cloud-checks --local",
    "tina:dev": "tinacms dev --noTelemetry --skip-cloud-checks --local",
    "cap:sync": "node scripts/cap-sync.mjs",
    "cap:sync:release": "node scripts/cap-sync-release.mjs",
    "cap:android:setup": "node scripts/android-play-one-time-setup.mjs",
    "cap:android:preflight": "node scripts/android-play-preflight.mjs",
    "cap:android:bundle": "node scripts/android-play-bundle.mjs",
    "cap:android:release": "node scripts/android-play-release.mjs",
    "cap:copy": "cap copy",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "test:e2e": "playwright test -c playwright.config.cjs",
    "test:e2e:support-unit": "playwright test -c playwright.support-unit.config.cjs",
    "test:e2e:all": "npm run test:e2e:support-unit && npm run test:e2e",
    "test:e2e:ui": "playwright test -c playwright.config.cjs --ui",
    "test": "node --import ./scripts/register-node-test-loader.mjs --test \"src/**/__tests__/*.test.mjs\"",
    "test:e2e:headed": "playwright test -c playwright.config.cjs --headed",
    "test:e2e:install": "playwright install chromium",
    "e2e:setup-user": "node scripts/ensure-e2e-test-user.mjs",
    "stripe:login": "stripe login",
    "stripe:listen": "stripe listen --forward-to localhost:3032/api/webhooks/stripe --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,account.updated",
    "stripe:listen:all": "stripe listen --forward-to http://127.0.0.1:3032/api/webhooks/stripe",
    "stripe:webhook-secret": "stripe listen --print-secret",
    "stripe:setup-webhook": "node scripts/stripe-setup-webhook.mjs",
    "stripe:e2e:setup": "node scripts/stripe-e2e-money-path-setup.mjs",
    "test:e2e:money-path": "playwright test -c playwright.config.cjs monetization-money-path",
    "geo:pt:audit": "node scripts/audit-portugal-adm3.mjs",
    "geo:pt:adm2": "node scripts/generate-portugal-full-seed.js",
    "geo:pt:concelhos": "node scripts/generate-portugal-concelhos-upsert.js",
    "geo:pt:adm3": "node scripts/generate-portugal-adm3-parish-boundaries-gap-fill.js",
    "geo:pt:caop-localities": "node scripts/generate-portugal-caop-localities-gap-fill.js",
    "geo:pt:reseed": "node scripts/reseed-portugal-geography.mjs",
    "geo:pt:apply": "node scripts/apply-sql-batches.mjs",
    "tags:reseed": "node scripts/reseed-tags-catalog.mjs",
    "db:audit-grants": "node scripts/audit-api-table-grants.mjs",
    "db:apply-grants": "node scripts/audit-api-table-grants.mjs --apply",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
